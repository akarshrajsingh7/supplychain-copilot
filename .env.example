# deterministic = real Deep Agents harness with a scripted, offline tool-calling model.
# live = same harness with ChatOpenAI. All numeric results still come from tools.
AGENT_MODE=deterministic
MEMORY_MODE=graphiti
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplychain-demo
# Optional Graphiti extraction; structured Graphiti writes work if extraction fails.
GRAPHITI_EXTRACT=false
GRAPHITI_TELEMETRY_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supplychain-copilot
DEMO_STEP_DELAY=0.8
