# deterministic = real Deep Agents harness with a scripted, offline tool-calling model.
# live = same harness with ChatOpenAI. All numeric results still come from tools.
AGENT_MODE=deterministic
MEMORY_MODE=graphiti
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# cost-aware: routine tasks use a cheaper model, planner/critic use a thinking model.
# Sourcing escalates to the thinking model after a rejected plan. single uses OPENAI_MODEL everywhere.
MODEL_ROUTING=cost-aware
OPENAI_ROUTINE_MODEL=gpt-4.1-mini
OPENAI_THINKING_MODEL=gpt-5.4
OPENAI_THINKING_EFFORT=medium
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supplychain-demo
# Optional Graphiti extraction; structured Graphiti writes work if extraction fails.
GRAPHITI_EXTRACT=false
GRAPHITI_TELEMETRY_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supplychain-copilot
# Use the endpoint matching the LangSmith account's region, e.g. EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Tracing-only keys can upload traces and evaluation outputs, but not scores/experiments.
LANGSMITH_PUBLISH_FEEDBACK=false
# Optional direct trace links without project-read permissions:
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_PROJECT_ID=
# Enable SDK URL lookups only with a key allowed to read projects:
LANGSMITH_RESOLVE_TRACE_URLS=false
DEMO_STEP_DELAY=0.8
# Read-only graph Q&A: local model endpoint. Hosted keys are entered in the UI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
